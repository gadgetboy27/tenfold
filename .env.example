# ============================================================
# prettymuch.nz — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Settings → API → Project URL + anon/public key + service_role key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# ── Database (Drizzle ORM) ─────────────────────────────────────
# Settings → Database → Connection string (Transaction pooler, port 6543)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# ── App URL ────────────────────────────────────────────────────
# No trailing slash. Use http://localhost:3000 for dev, https://prettymuch.nz in prod.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── fal.ai ────────────────────────────────────────────────────
# Get from: https://fal.ai/dashboard/keys
FAL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic ─────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Meta (Facebook + Instagram) OAuth ────────────────────────
# Create app at: https://developers.facebook.com/apps/
# App Dashboard → Settings → Basic → App ID + App Secret
# Required permissions: pages_show_list, pages_manage_posts, pages_read_engagement,
#                       instagram_basic, instagram_content_publish
# Redirect URI to register: {APP_URL}/api/social/callback/facebook
META_APP_ID=XXXXXXXXXXXXXXXX
META_APP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Direct publishing backend (lib/social/direct/) ────────────
# Free, no platform review — this is what runs instead of Ayrshare by default.
#
# Bluesky needs NOTHING here: users paste their own handle + app password
# (Bluesky app → Settings → App Passwords) at Settings → Social.
#
# Reddit: create a "web app" at https://www.reddit.com/prefs/apps
#   redirect uri → {APP_URL}/api/social/callback/reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# LinkedIn — create an app at https://www.linkedin.com/developers/apps
# Products needed: "Sign In with LinkedIn using OpenID Connect" + "Share on
# LinkedIn". Redirect URL: {APP_URL}/api/social/callback/linkedin
# Member-feed posting only; Company Pages need LinkedIn's Community Management
# review (see lib/social/direct/linkedin.ts).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com
# Product: Content Posting API. Redirect: {APP_URL}/api/social/callback/tiktok
# TWO GATES: the app must pass TikTok's audit before it may post anything other
# than privacy_level SELF_ONLY, and PULL_FROM_URL only accepts media on a domain
# verified in the developer portal (that's the Supabase Storage host, not ours).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube — Google Cloud project with the YouTube Data API v3 enabled.
# Redirect: {APP_URL}/api/social/callback/youtube
# GATE: youtube.upload is a RESTRICTED scope. Unverified apps only work for
# accounts added as test users and show an "unverified app" warning; real use
# needs Google's OAuth verification (a security review). Uploads cost ~1600 of
# a 10,000/day quota, so ~6 videos/day until you request more.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Outstand — the paid BROKER backend (lib/social/broker/outstand.ts).
# Optional. Absent, brokered networks are simply not offered.
# Reaches networks our own review hasn't cleared, billed ~$0.007/post and
# charged on to the workspace as CREDIT_COSTS.brokered_publish. Publishing to
# a network we reach ourselves stays FREE — see that constant for why.
OUTSTAND_API_KEY=
# Pinterest: create an app at https://developers.pinterest.com/apps/
#   redirect uri → {APP_URL}/api/social/callback/pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Ayrshare (opt-in — off unless explicitly enabled) ─────────
# Covers X / LinkedIn / TikTok / YouTube / Threads / Snapchat / GMB, i.e. every
# network whose own API is gated behind a paid tier or an app review. That
# access is what the subscription buys, and it is not cheap ($599/mo Business,
# the tier the generateJWT profile flow below requires) — so the integration
# stays fully built but DARK until this is "true".
# With it unset/false: Facebook + Instagram (Meta Graph) and Bluesky + Reddit +
# Pinterest (direct backend) still publish normally; the rest return a clear
# "temporarily unavailable" per platform instead of failing obscurely.
AYRSHARE_ENABLED=false
# Business Plan account. Get the API key from: https://app.ayrshare.com/dashboard/api
AYRSHARE_API_KEY=XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX
# Hosted social-connect (generateJWT) for the non-Meta networks. One-time setup:
# Ayrshare dashboard (Business) → User Profiles → generate the JWT key pair + domain.
# Store the PEM with literal \n between lines (the code restores real newlines).
AYRSHARE_DOMAIN=
AYRSHARE_PRIVATE_KEY=

# ── Stripe ────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Get from: https://dashboard.stripe.com/webhooks (add endpoint → select all events)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs — Dashboard → Products → create one price per plan (recurring, monthly, NZD)
STRIPE_PRICE_25CR=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_100CR=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_300CR=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_CREATOR_MONTHLY=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_BUSINESS_MONTHLY=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_AGENCY_MONTHLY=price_XXXXXXXXXXXXXXXXXXXXXXXX
# Add-ons — recurring, monthly, sold alongside a tier subscription (not a tier itself)
STRIPE_PRICE_BLEND_ADDON=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ── Resend ────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Auth: set to "false" to require email confirmation before login (default: auto-confirm on)
AUTH_AUTOCONFIRM_SIGNUP=true

# ── Cron ──────────────────────────────────────────────────────
# Bearer token guarding /api/cron/* (analytics, model-review). Defaults to
# "dev-secret" locally; set a strong value in production.
CRON_SECRET=
# Where the monthly model-review report is emailed (see /api/cron/model-review).
# Leave empty to skip the email — the cron still returns the JSON report.
MODEL_REVIEW_EMAIL=

# ── Admin override (live testing) ──────────────────────────────
# Comma-separated emails that unlock the FULL toolset (top tier) regardless of
# subscription. Matched against the WORKSPACE OWNER's email. Leave empty in
# normal operation. e.g. ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# ── Feature flags (lib/flags.ts) ──────────────────────────────
# Dark-launch switches. A feature is ON only when its var is exactly "1";
# unset/anything-else = off (fail closed). Server-side + runtime-read, so
# flipping one takes effect on restart with no rebuild. See LOGO_PRODUCTION.md.
FEATURE_LOGO_BUILDER=

# Domain outbound transactional mail is sent FROM (Resend must have it
# verified). Separate from the site domain — see lib/email/sender.ts.
# Defaults to the currently verified tenfold.nz when unset.
EMAIL_SENDER_DOMAIN=

# Guided brief agent (slice 1). Absent in production unless exactly "1".
FEATURE_BRIEF_AGENT=

# The foreman orchestrator. Absent unless exactly "1".
FEATURE_FOREMAN=
